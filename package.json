{
  "name": "blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist/server",
    "start": "node server.js --production",
    "create-admin": "node server/create-admin.js",
    "import-posts": "node server/import-posts.js",
    "import-db": "node server/import-db.js",
    "lint": "eslint .",
    "preview": "npm start"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "framer-motion": "^13.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.79.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "styled-component": "^2.8.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.9.6",
    "vite": "^8.0.12"
  }
}
