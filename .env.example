# Скопируйте этот файл в .env в корне Blog.
# ВСТАВЬТЕ СЮДА свою строку подключения MongoDB / MongoDB Atlas для Mongoose.
# Локальный пример: mongodb://127.0.0.1:27017/blog
MONGODB_URI=

# В production обязателен случайный секрет от 32 символов.
# Сгенерировать: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=5173
HOST=127.0.0.1

# Внешний адрес за HTTPS reverse proxy, например https://blog.example.com
PUBLIC_ORIGIN=

# Необязательный ключ OpenWeather для существующего блока погоды в футере.
WEATHER_API_KEY=
